---
import SectionHeader from "../home/SectionHeader.astro";
import ProjectCard from "./projects/ProjectCard.astro";

// 项目数据
const projects = [
  {
    title: "校园信息管理系统",
    description:
      "为学校开发的综合信息管理平台，包括学生管理、课程管理、成绩管理等功能。",
    icon: `<img src="/images/t1.jpg" alt="校园信息管理系统" class="w-full h-full object-cover" />`,
    technologies: ["Java", "Spring Boot", "MySQL"],
  },
  {
    title: "移动学习平台",
    description:
      "一款面向学生的移动学习应用，提供课程学习、资料下载、在线测试等功能。",
    icon: `<img src="/images/t2.jpg" alt="移动学习平台" class="w-full h-full object-cover" />`,
    technologies: ["React Native", "Node.js", "MongoDB"],
  },
  {
    title: "智能图书管理系统",
    description:
      "为图书馆开发的智能管理系统，包括图书借阅、归还、查询、推荐等功能。",
    icon: `<img src="/images/t3.jpg" alt="智能图书管理系统" class="w-full h-full object-cover" />`,
    technologies: ["Python", "Django", "PostgreSQL"],
  },
];
---

<!-- 项目展示 -->
<section id="projects" class="bg-card/50 py-16 pt-24 md:pt-28">
  <div class="container mx-auto px-4 md:px-6">
    <SectionHeader
      title="项目展示"
      description="我们的团队已经成功完成了多个优秀项目"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            icon={project.icon}
            technologies={project.technologies}
          />
        ))
      }
    </div>
  </div>
</section>
